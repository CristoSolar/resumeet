  font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--grey);
  display:flex;justify-content:space-between}
:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
</style>
"""


def rec_badge():
    if STATE.is_file():
        return '<span class="rec"><span class="dot"></span>REC</span>'
    return ""


def page(title, body):
    return (
        f"<title>{html.escape(title)} — Resumeet</title>{STYLE}<main>"
        f'<header>{LOGO}<span class="brand">Resumeet<small>{T["tagline"]}</small></span>{rec_badge()}</header>'
        f"{body}"
        f'<footer><span>Resumeet</span><span>local · {html.escape(str(BASE))}</span></footer></main>'
    ).encode()


def fecha_larga(name):
    try:
        dt = datetime.strptime(name, "%Y-%m-%d_%H%M")
        return f"{dt.day:02d} {T['meses'][dt.month - 1]} {dt.year}", f"{dt.hour:02d}:{dt.minute:02d}"
    except ValueError:
        return name, ""


def titulo(d: Path) -> str:
    try:
        return (d / "titulo.txt").read_text(errors="replace").strip().splitlines()[0]
    except (OSError, IndexError):
        return ""


def dur(d: Path) -> str:
    # ponytail: duracion por tamano de archivo (16kHz mono s16 = 32000 B/s), sin parsear header
    try:
        secs = max(0, (d / "mic.wav").stat().st_size - 44) // 32000
        return f"{secs // 60} {T['min']}" if secs >= 60 else f"{secs} s"
    except OSError:
        return ""


def md_html(text: str) -> str:
    # ponytail: markdown minimo (headers, bullets, negrita); suficiente para
    # lo que emite meet-rec, sin libreria
    out, in_list = [], False
    for line in text.splitlines():
        line = html.escape(line)
        line = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", line)
        if line.startswith("- "):
            if not in_list:
                out.append("<ul>")
                in_list = True
            out.append(f"<li>{line[2:]}</li>")
            continue
        if in_list:
            out.append("</ul>")
            in_list = False
        if line.startswith("### "):
            out.append(f"<h4>{line[4:]}</h4>")
        elif line.startswith("## "):
            out.append(f"<h3>{line[3:]}</h3>")
        elif line.startswith("# "):
            out.append(f"<h3>{line[2:]}</h3>")
        elif line.strip():
            out.append(f"<p>{line}</p>")
    if in_list:
        out.append("</ul>")
    return "".join(out)


def md_block(d: Path, name: str) -> str:
    f = d / name
    if not f.is_file():
        return f'<p class="missing">{T["missing"]}</p>'
    return f'<div class="doc">{md_html(f.read_text(errors="replace"))}</div>'


class Handler(BaseHTTPRequestHandler):
    def send(self, code, body, ctype="text/html; charset=utf-8", extra=()):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        parts = [unquote(p) for p in self.path.strip("/").split("/") if p]
        if any(not SAFE.match(p) for p in parts):
            return self.send(400, b"nombre invalido", "text/plain")
        try:
            if not parts:
                return self.index()
            if parts[0] == "m" and len(parts) == 2:
                return self.meeting(parts[1])
            if parts[0] == "f" and len(parts) == 3:
                return self.file(parts[1], parts[2])
            self.send(404, b"no encontrado", "text/plain")
        except BrokenPipeError:
            pass  # el navegador corta los <audio> a medio stream; normal

    def index(self):
        dirs = sorted((d for d in BASE.iterdir() if d.is_dir()), reverse=True)
        items = ""
        for d in dirs:
            fecha, hora = fecha_larga(d.name)
            tag = "" if (d / "resumen.md").is_file() else f'<span class="tag">{T["no_summary"]}</span>'
            t = titulo(d)
            # Con titulo: el nombre manda y la fecha pasa a secundaria.
            grande, chico = (html.escape(t), f"{fecha} {hora}") if t else (fecha, hora)
            items += (
                f'<li><a href="/m/{d.name}"><span class="fecha">{grande}</span>'
                f'<span class="hora">{chico}</span>'
                f'<span class="meta">{dur(d)} {tag}</span></a></li>'
            )
        body = f'<ul class="list">{items}</ul>' if items else f'<div class="empty">{T["empty"]}</div>'
        self.send(200, page(T["meetings"], f'<h1>{T["meetings"]}</h1><p class="sub">{len(dirs)} {T["recorded"]}</p>{body}'))

    def meeting(self, name):
        d = BASE / name
        if not d.is_dir():
            return self.send(404, b"no encontrado", "text/plain")
        fecha, hora = fecha_larga(name)
        t = titulo(d)
        nombre = t or fecha  # crudo para page(), que escapa el <title>
        h1 = html.escape(nombre)
        sub = f"{fecha} · {hora} · {dur(d)}" if t else f"{hora} · {dur(d)}"
        audios = "".join(
            f'<span class="track">{label}</span><audio controls preload="metadata" src="/f/{name}/{track}.wav"></audio>'
            for label, track in ((T["mic"], "mic"), (T["remote"], "remoto"))
            if (d / f"{track}.wav").is_file()
        ) or f'<p class="missing">{T["no_audio"]}</p>'
        body = (
            f'<h1>{h1}</h1><p class="sub">{sub}</p>'
            f'<h2><span class="shape o"></span>{T["audio"]}</h2>{audios}'
            f'<h2><span class="shape"></span>{T["summary"]}</h2>{md_block(d, "resumen.md")}'
            f'<h2><span class="shape t"></span>{T["actions"]}</h2>{md_block(d, "analisis.md")}'
            f'<h2><span class="shape d"></span>{T["transcript"]}</h2>'
            f'<details><summary>{T["full_transcript"]}</summary>{md_block(d, "transcripcion.md")}</details>'
            f'<a class="back" href="/">{T["back"]}</a>'
        )
        self.send(200, page(nombre, body))

    def file(self, name, fname):
        f = BASE / name / fname
        if not f.is_file():
            return self.send(404, b"no encontrado", "text/plain")
        ctype = "audio/wav" if fname.endswith(".wav") else "text/plain; charset=utf-8"
        size = f.stat().st_size
        # Range: los <audio> de Chromium/Vivaldi lo exigen para reproducir y buscar.
        m = re.match(r"bytes=(\d*)-(\d*)$", self.headers.get("Range", ""))
        if m and (m[1] or m[2]):
            start = int(m[1]) if m[1] else max(0, size - int(m[2]))
            end = min(int(m[2]), size - 1) if m[1] and m[2] else size - 1
            if start >= size:
                return self.send(416, b"", extra=[("Content-Range", f"bytes */{size}")])
            with open(f, "rb") as fh:
                fh.seek(start)
                chunk = fh.read(end - start + 1)
            return self.send(206, chunk, ctype, extra=[
                ("Content-Range", f"bytes {start}-{end}/{size}"),
                ("Accept-Ranges", "bytes"),
            ])
        self.send(200, f.read_bytes(), ctype, extra=[("Accept-Ranges", "bytes")])

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    if "--check" in sys.argv:  # self-test sin red
        assert b"Resumeet" in page(T["meetings"], "<ul></ul>")
        assert not SAFE.match("../etc") and SAFE.match("2026-09-01_0938")
        assert fecha_larga("2026-09-01_1308") == ("01 sep 2026", "13:08")  # sep es igual en ambos idiomas
        assert re.match(r"bytes=(\d*)-(\d*)$", "bytes=0-")[1] == "0"
        import tempfile
        with tempfile.TemporaryDirectory() as td:
            (Path(td) / "titulo.txt").write_text("Kickoff\nextra")
            assert titulo(Path(td)) == "Kickoff" and titulo(Path(td) / "nada") == ""
        print("OK")
        sys.exit(0)
    print(f"Resumeet en http://127.0.0.1:{PORT}  (Ctrl+C para parar)")
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
