#!/usr/bin/env python3
"""Resumeet: front local para revisar reuniones de meet-rec.

Sirve ~/Reuniones en http://127.0.0.1:8765 — indice de reuniones,
resumen, transcripcion y reproductores de audio por pista.
Solo stdlib. Ctrl+C para parar.
"""
import html
import os
import re
import sys
from datetime import datetime
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from pathlib import Path
from urllib.parse import unquote

BASE = Path(os.environ.get("MEET_REC_DIR", Path.home() / "Reuniones"))
PORT = int(os.environ.get("MEET_VIEW_PORT", "8765"))
STATE = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "meet-rec.state"

# ponytail: solo se sirven nombres con este patron; suficiente contra traversal
SAFE = re.compile(r"^[\w.\-]+$")

# ponytail: dos idiomas en un dict; i18n de verdad cuando haya un tercero
LANG = "en" if (os.environ.get("RESUMEET_UI_LANG") or os.environ.get("RESUMEET_LANG", "es")).lower().startswith("en") else "es"
T = {
    "es": {
        "meses": ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"],
        "tagline": "notas &amp; audio de reuniones",
        "meetings": "Reuniones", "recorded": "grabadas", "no_summary": "sin resumen",
        "empty": "No hay reuniones todavia — SUPER+SHIFT+R para grabar",
        "audio": "Audio", "summary": "Resumen", "actions": "Pasos a seguir",
        "transcript": "Transcripcion", "full_transcript": "Transcripcion completa",
        "mic": "Yo — microfono", "remote": "Ellos — remoto",
        "no_audio": "sin pistas de audio", "missing": "no existe",
        "back": "&larr; Todas las reuniones", "min": "min",
    },
    "en": {
        "meses": ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"],
        "tagline": "meeting notes &amp; audio",
        "meetings": "Meetings", "recorded": "recorded", "no_summary": "no summary",
        "empty": "No meetings yet — press SUPER+SHIFT+R to record",
        "audio": "Audio", "summary": "Summary", "actions": "Next steps",
        "transcript": "Transcript", "full_transcript": "Full transcript",
        "mic": "Me — microphone", "remote": "Them — remote",
        "no_audio": "no audio tracks", "missing": "not available",
        "back": "&larr; All meetings", "min": "min",
    },
}[LANG]

LOGO = """<svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
<rect width="32" height="32" fill="var(--ink)"/>
<g stroke="var(--paper)" stroke-width="2.5" stroke-linecap="round">
<line x1="8" y1="14" x2="8" y2="18"/><line x1="13" y1="10" x2="13" y2="22"/>
<line x1="18" y1="7" x2="18" y2="25"/><line x1="24" y1="12" x2="24" y2="20"/>
</g></svg>"""

STYLE = """
